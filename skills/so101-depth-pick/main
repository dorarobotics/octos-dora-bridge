@contextmanager
def redirect_native_stdout_to_stderr():
    """Route native SDK stdout noise to stderr while keeping final JSON clean."""
    sys.stdout.flush()
    sys.stderr.flush()
    saved_stdout = os.dup(1)
    stderr_fd = os.dup(2)
    try:
        os.dup2(stderr_fd, 1)
        yield
    finally:
        sys.stdout.flush()
        sys.stderr.flush()
        os.dup2(saved_stdout, 1)
        os.close(saved_stdout)
        os.close(stderr_fd)


def emit(output, success):
    print(json.dumps({"output": output if isinstance(output, str) else json.dumps(output), "success": bool(success)}))
    raise SystemExit(0)


def read_args():
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    args = json.loads(raw) if raw.strip() else {}
    return resolve_profile_args(args)


def profile_path(profile_name: str) -> Path:
    name = str(profile_name).strip()
    if not name or Path(name).name != name or name.endswith(".json"):
        raise ValueError("profile must be a simple name without path separators or .json suffix")
    return SKILL_DIR / PROFILE_DIR_NAME / f"{name}.json"


def load_profile(profile_name: str) -> dict:
    path = profile_path(profile_name)
    if not path.exists():
        raise ValueError(f"profile not found: {profile_name}")
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise ValueError(f"profile must contain a JSON object: {profile_name}")
    return data


def resolve_profile_args(args: dict) -> dict:
    args = dict(args or {})
    profile_name = args.get("profile")
    if not profile_name:
        return args
    profile = load_profile(str(profile_name))
    resolved = dict(profile)
    resolved.update(args)
    return resolved


def validate_detector(args):
    detector = str(args.get("detector", "open3d_geometry"))
    if detector not in SUPPORTED_DETECTORS:
        raise ValueError(
            f"unsupported detector: {detector}. Supported detectors: {', '.join(sorted(SUPPORTED_DETECTORS))}"
        )
    return detector


def draw_pick_monitor_overlay(color_bgr, objects, *, stage, base_points=None, message=None):
    import cv2

    image = np.asarray(color_bgr).copy()
    base_points = base_points or {}
    header = f"SO101 pick monitor | {stage}"
    if message:
        header = f"{header} | {message}"
    cv2.rectangle(image, (0, 0), (image.shape[1], 34), (20, 20, 20), -1)
    cv2.putText(image, header, (10, 23), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 2)
    cv2.putText(image, header, (10, 23), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (40, 220, 255), 1)

    for index, obj in enumerate(objects or []):
        x, y, w, h = [int(v) for v in obj.bbox]
        color = (0, 180, 255) if obj.color == "orange" else (0, 255, 0)
        cv2.rectangle(image, (x, y), (x + w, y + h), color, 2)
        label = (
            f"{index}: {obj.color or obj.category} "
            f"{obj.distance_m:.3f}m "
            f"{obj.estimated_size_m.width:.3f}x{obj.estimated_size_m.height:.3f}"
        )
        label_y = max(52, y - 7)
        cv2.putText(image, label, (x, label_y), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (0, 0, 0), 3)
        cv2.putText(image, label, (x, label_y), cv2.FONT_HERSHEY_SIMPLEX, 0.45, color, 1)

    y = image.shape[0] - 12
    for name, point in reversed(list(base_points.items())):
        text = f"{name}: base [{float(point[0]):.3f}, {float(point[1]):.3f}, {float(point[2]):.3f}]"
        cv2.putText(image, text, (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (0, 0, 0), 3)
        cv2.putText(image, text, (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255, 255, 255), 1)
        y -= 20
        if y < 50:
            break
    return image


class PickMonitor:
    def __init__(self, args):
        self.enabled = bool(args.get("show_viewer", False))
        self.live_enabled = bool(args.get("viewer_live", False))
        self.max_fps = float(args.get("viewer_max_fps", 6.0))
        self.window_name = str(args.get("viewer_window") or DEFAULT_PICK_VIEWER_WINDOW)
        self.save_path = Path(str(args.get("viewer_save_path") or DEFAULT_PICK_VIEWER_SAVE_PATH))
        self.last_frame = None
        self.last_objects = []
        self.last_base_points = {}
        self.last_stage = "idle"
        self.last_message = None
        self._cv2 = None
        self._lock = threading.RLock()
        self._stop_live = threading.Event()
        self._live_thread = None
        if self.enabled:
            import cv2

            self._cv2 = cv2
            self.save_path.parent.mkdir(parents=True, exist_ok=True)
            cv2.namedWindow(self.window_name, cv2.WINDOW_NORMAL)

    def _render_locked(self):
        if not self.enabled or self.last_frame is None:
            return
        overlay = draw_pick_monitor_overlay(
            self.last_frame,
            self.last_objects,
            stage=self.last_stage,
            base_points=self.last_base_points,
            message=self.last_message,
        )
        self._cv2.imshow(self.window_name, overlay)
        self._cv2.imwrite(str(self.save_path), overlay)
        self._cv2.waitKey(1)

    def update(self, stage, *, frame=None, objects=None, base_points=None, message=None):
        with self._lock:
            self.last_stage = str(stage)
            self.last_message = message
            if frame is not None:
                self.last_frame = frame.color_bgr if hasattr(frame, "color_bgr") else frame
            if objects is not None:
                self.last_objects = list(objects)
            if base_points:
                self.last_base_points.update(base_points)
            self._render_locked()

    def start_live(self, args):
        if not self.enabled or not self.live_enabled:
            return
        if self._live_thread is not None and self._live_thread.is_alive():
            return
        live_args = dict(args)
        self._stop_live.clear()
        self._live_thread = threading.Thread(
            target=self._live_loop,
            args=(live_args,),
            name="so101-pick-monitor-live",
            daemon=True,
        )
        self._live_thread.start()

    def stop_live(self):
        thread = self._live_thread
        if thread is None:
            return
        self._stop_live.set()
        thread.join(timeout=15.0)
        if thread.is_alive():
            return
        self._live_thread = None

    def _live_loop(self, args):
        interval = 1.0 / self.max_fps if self.max_fps > 0 else 0.0
        while not self._stop_live.is_set():
            started_at = time.monotonic()
            try:
                frame, objects = capture_frame_objects(args)
                with self._lock:
                    self.last_frame = frame.color_bgr if hasattr(frame, "color_bgr") else frame
                    self.last_objects = list(objects)
                    self.last_message = f"live objects={len(objects)}"
                    self._render_locked()
            except Exception as exc:
                with self._lock:
                    self.last_message = f"live error: {exc}"
                    self._render_locked()
                self._stop_live.wait(0.5)
            if interval > 0:
                elapsed = time.monotonic() - started_at
                self._stop_live.wait(max(0.0, interval - elapsed))

    def close(self):
        self.stop_live()
        if self.enabled and self._cv2 is not None:
            try:
                self._cv2.destroyWindow(self.window_name)
            except Exception:
                pass


def maybe_pick_monitor(args):
    return PickMonitor(args) if bool(args.get("show_viewer", False)) else None


def perception_viewer_args(args):
    viewer_args = dict(args)
    viewer_args.setdefault("show_viewer", True)
    viewer_args.setdefault("viewer_live", True)
    viewer_args.setdefault("viewer_window", "SO101 perception monitor")
    viewer_args.setdefault("viewer_save_path", "/tmp/octos_perception_view/last_overlay.png")
    return viewer_args


def detect_objects(args):
    viewer_args = perception_viewer_args(args)
    monitor = maybe_pick_monitor(viewer_args)
    try:
        frame, objects = capture_frame_objects(viewer_args)
        if monitor is not None:
            monitor.update(
                "detect objects",
                frame=frame,
                objects=objects,
                message=f"objects={len(objects)}",
            )
            if bool(viewer_args.get("viewer_live", False)):
                monitor.start_live(viewer_args)
                hold_s = float(viewer_args.get(
                    "viewer_hold_s",
                    os.environ.get("SO101_PERCEPTION_VIEWER_HOLD_S", 30.0),
                ))
                deadline = time.monotonic() + max(0.0, hold_s)
                while time.monotonic() < deadline:
                    time.sleep(0.1)
        return {
            "objects": [obj.to_dict() for obj in objects],
            "viewer": {
                "shown": bool(monitor is not None),
                "live": bool(viewer_args.get("viewer_live", False)),
                "hold_s": float(viewer_args.get(
                    "viewer_hold_s",
                    os.environ.get("SO101_PERCEPTION_VIEWER_HOLD_S", 30.0),
                )),
                "save_path": str(viewer_args.get("viewer_save_path") or DEFAULT_PICK_VIEWER_SAVE_PATH),
            },
        }
    finally:
        if monitor is not None:
            monitor.close()


def yolo_class_names(args):
    value = args.get("yolo_classes")
    if value is None:
        value = os.environ.get("YOLO_CLASSES")
    if isinstance(value, str):
        names = [item.strip() for item in value.split(",")]
    elif isinstance(value, list):
        names = [str(item).strip() for item in value]
    else:
        names = []
    return [name for name in names if name]


def open3d_workspace_bounds(args):
    value = args.get("workspace_bounds_m") or args.get("open3d_workspace_bounds_m")
    if value is None:
        raw = os.environ.get("OPEN3D_WORKSPACE_BOUNDS_M")
        if raw:
            value = json.loads(raw)
    return value


def open3d_image_roi_fraction(args):
    value = args.get("image_roi_fraction") or args.get("open3d_image_roi_fraction")
    if value is None:
        raw = os.environ.get("OPEN3D_IMAGE_ROI_FRACTION")
        if raw:
            value = json.loads(raw)
    return value


def create_object_detector(args):
    from octos_object_perception.detectors import ColorSizeDetector, Open3DGeometryDetector, PropDetector, YoloSegDetector

    detector_name = validate_detector(args)
    if detector_name == "open3d_geometry":
        return Open3DGeometryDetector(
            workspace_bounds_m=open3d_workspace_bounds(args),
            image_roi_fraction=open3d_image_roi_fraction(args),
            voxel_size_m=float(args.get("open3d_voxel_size_m", os.environ.get("OPEN3D_VOXEL_SIZE_M", 0.005))),
            table_distance_threshold_m=float(
                args.get("open3d_table_threshold_m", os.environ.get("OPEN3D_TABLE_THRESHOLD_M", 0.01))
            ),
            dbscan_eps_m=float(args.get("open3d_dbscan_eps_m", os.environ.get("OPEN3D_DBSCAN_EPS_M", 0.025))),
            dbscan_min_points=int(
                args.get("open3d_dbscan_min_points", os.environ.get("OPEN3D_DBSCAN_MIN_POINTS", 30))
            ),
            min_cluster_points=int(
                args.get("open3d_min_cluster_points", os.environ.get("OPEN3D_MIN_CLUSTER_POINTS", 80))
            ),
        )
    if detector_name in {"prop_detector", "yolo_seg"}:
        detector = YoloSegDetector(
            model_path=args.get("yolo_model_path") or os.environ.get("YOLO_MODEL_PATH"),
            class_names=yolo_class_names(args),
            confidence=float(args.get("yolo_confidence", os.environ.get("YOLO_CONFIDENCE", 0.25))),
            device=args.get("yolo_device") or os.environ.get("YOLO_DEVICE", "cpu"),
        )
        if detector_name == "prop_detector":
            return PropDetector(base_detector=detector)
        return detector
    return ColorSizeDetector(min_area_px=int(args.get("min_area_px", 120)))


def configure_so101_runtime():
    skill_pack = os.environ.get("SO101_MOVEIT_SKILL_PACK", str(DEFAULT_MOVEIT_SKILL_PACK))
    os.environ["SKILL_PACK"] = skill_pack
